{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOCT",
  "version": "0.1.0",
  "identifier": "com.nocturne.codex",
  "build": {
    "frontendDist": "../noct-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd noct-ui && trunk serve --port 1420",
    "beforeBuildCommand": "cd noct-ui && trunk build --release"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local desktop engineering workspace",
    "longDescription": "NOCT keeps the state of a software project and coordinates the developer with the AI providers they choose. Every file change waits for the developer's approval.",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwNTAzQjYyNEQ4N0Q2NDYKUldSRzFvZE5ZanRRUU54c3A1UHRkUG1yNE5nL3Q5cm9IMHJONjBIVVRZRGZDNVZXMVNaRFJxQncK",
      "endpoints": [
        "https://github.com/gustavomfg/NOCT/releases/download/updater-feed/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
