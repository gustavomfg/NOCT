{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window may use the core defaults and the commands of the first slice, and nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-settings-get",
    "allow-settings-set",
    "allow-workspaces-list",
    "allow-brain-create",
    "allow-conversations-create",
    "allow-conversations-list",
    "allow-workspace-set-favorite"
  ]
}
