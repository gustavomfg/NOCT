{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window may use the core defaults and the commands of the first slice, and nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-settings-get",
    "allow-settings-set",
    "allow-workspaces-list",
    "allow-brain-create",
    "allow-brain-extract",
    "allow-brain-update",
    "allow-suggestions-create",
    "allow-suggestions-status",
    "allow-models-set-bindings",
    "allow-models-bindings-get",
    "allow-models-set-default-model",
    "allow-ai-save-assistant",
    "allow-conversations-delete",
    "allow-workspace-remove",
    "allow-brain-delete",
    "allow-artifacts-delete",
    "allow-conversations-create",
    "allow-conversations-list",
    "allow-workspace-set-favorite",
    "allow-provider-key-status",
    "allow-provider-key-save",
    "allow-provider-key-remove",
    "allow-provider-consent-status",
    "allow-provider-consent-grant",
    "allow-provider-consent-revoke",
    "allow-provider-chat-status",
    "allow-provider-chat-send",
    "allow-provider-chat-cancel"
  ]
}
